ocio_profile_version: 2.0
search_path: ""
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
roles:
  default: Linear Rec.709
  reference: Linear Rec.709
  scene_linear: Linear Rec.709
  rendering: Linear Rec.709
  compositing_log: Linear Rec.709
  color_picking: sRGB
  color_timing: Linear Rec.709
  texture_paint: sRGB
  matte_paint: sRGB
  data: Non-Color
  default_byte: sRGB
  default_float: Linear Rec.709
  default_sequencer: sRGB
displays:
  sRGB:
    - !<View> {name: Standard, colorspace: sRGB}
active_displays: [sRGB]
active_views: [Standard]
colorspaces:
  - !<ColorSpace>
    name: Linear Rec.709
    bitdepth: 32f
    isdata: false
  - !<ColorSpace>
    name: sRGB
    bitdepth: 32f
    isdata: false
    to_scene_reference: !<ExponentWithLinearTransform> {gamma: [2.4, 2.4, 2.4, 1], offset: [0.055, 0.055, 0.055, 0]}
  - !<ColorSpace>
    name: Non-Color
    bitdepth: 32f
    isdata: true
