+/// Measure a fresh SDK connection and application of the probe snapshot with a retained identity.
+fn feed_snapshot() {
+    let lines = stdin_lines();
+    let req: Value = serde_json::from_str(&lines.recv().expect("request line")).expect("request JSON");
+    let start = Instant::now();
+    let (conn, _) = connect(req["uri"].as_str().unwrap(), req["db"].as_str().unwrap(), req["token"].as_str().unwrap(), Client::Game.confirmed());
+    let (sent, applied) = std::sync::mpsc::channel();
+    let errors = sent.clone();
+    conn.subscription_builder()
+        .on_applied(move |ctx| {
+            let _ = sent.send(Ok((start.elapsed().as_secs_f64() * 1000.0, ctx.db.my_feed_probe().count())));
+        })
+        .on_error(move |_, error| {
+            let _ = errors.send(Err(error.to_string()));
+        })
+        .subscribe(vec!["SELECT * FROM my_feed_probe"]);
+    let (ms, rows) = applied.recv_timeout(Duration::from_secs(30)).expect("probe snapshot").expect("probe subscription");
+    println!("{}", json!({"ms": ms, "rows": rows}));
+    let _ = conn.disconnect();
+}
