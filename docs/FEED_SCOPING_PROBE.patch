+#!/usr/bin/env python3
+"""Run one shadow-feed arm on a private SpacetimeDB server, under the Spark battle lock."""
+import argparse
+import fcntl
+import json
+import math
+import os
+from pathlib import Path
+import shutil
+import statistics
+import subprocess
+import time
+
+import battle_diag as battle
+import look_cost as load
+
+ROOT = Path(__file__).resolve().parents[2]
+VERIFY = ROOT / ".agents/skills/verify/scripts/verify.py"
+
+
+def host():
+    mem = int(next(line.split()[1] for line in Path("/proc/meminfo").read_text().splitlines()
+                   if line.startswith("MemAvailable:")))
+    return dict(time=time.strftime("%Y-%m-%dT%H:%M:%S%z"), load=os.getloadavg(),
+                available_memory_kib=mem, free_disk_bytes=shutil.disk_usage(ROOT).free)
+
+
+def check_host():
+    hour, minute = map(int, time.strftime("%H:%M").split(":"))
+    if hour < 2 or hour * 60 + minute >= 23 * 60 + 15:
+        raise RuntimeError("outside the permitted measurement window")
+    info = host()
+    if info["available_memory_kib"] < 40 * 1024**2 or info["free_disk_bytes"] < 45 * 1024**3:
+        raise RuntimeError(f"resource floor: {info}")
+    return info
+
+
+def run(args):
+    evidence = ROOT / ".local/living/verify" / args.run
+    evidence.mkdir(parents=True, exist_ok=False)
+    db = f"verify-{args.run}"
+    build_slot = Path.home() / "slop-mq/build-slot"
+    binary = Path(os.environ["CARGO_TARGET_DIR"]) / "release/gate-load"
+    seed = str(args.woods_seed.with_suffix("")) if args.workload == "woods" else "cullet"
+
+    def harness(command, *extra):
+        prefix = [build_slot] if command == "launch" else []
+        with (evidence / "harness.log").open("a") as log:
+            subprocess.run([*prefix, VERIFY, command, "--run", args.run, *extra],
+                           stdout=log, stderr=subprocess.STDOUT, check=True)
+
+    def stdb(*cli, timeout=180):
+        return load.sh("docker", "exec", "-i", load.CONTAINER, "spacetime", *cli, timeout=timeout)
+
+    load.stdb = stdb
+    client = None
+    attempted = False
+    try:
+        (evidence / "host-before-launch.json").write_text(json.dumps(check_host()))
+        attempted = True
+        harness("launch", "--seed", seed, "--target-dir", os.environ["CARGO_TARGET_DIR"])
+        harness("doctor")
+        owner = load.admin_token()
+
+        def sql(query):
+            return load.sql(db, query, owner)
+
+        def call(reducer, *values):
+            load.call(db, reducer, values, owner)
+
+        for key, value in {"feed_scope_probe": args.arm == "on", "profile_detail": True,
+                           "cover_sight_on": True, "fov_on": args.workload != "round",
+                           "gaze_on": args.workload != "round"}.items():
+            call("set_world_law", key, json.dumps(value))
+
+        def census():
+            return {row["id"]: row for row in sql("SELECT id, name, alive FROM character") if row["alive"]}
+
+        ambient = len(census())
+        fighters = []
+        center = (0, 0)
+        if args.workload == "woods":
+            call("set_paused", True)
+            for key in ("dmg_strike", "dmg_strike_spear"):
+                call("set_world_law", key, "0.05")
+            before = census()
+            call("spawn_crowd", 96, True)
+            fighters = sorted(census().keys() - before.keys())
+            if len(fighters) != 96:
+                raise RuntimeError(f"expected 96 fighters, got {len(fighters)}")
+            center = (276, 224)
+            tiles = {}
+            positions = []
+            for y in range(216, 233):
+                for x in range(268, 285):
+                    chunk = (y // 16 << 16) | x // 16
+                    if chunk not in tiles:
+                        row, = sql(f"SELECT tiles FROM terrain_chunk WHERE id = {chunk}")
+                        data = row["tiles"]
+                        tiles[chunk] = bytes.fromhex(data.removeprefix("0x")) if isinstance(data, str) else bytes(data)
+                    if tiles[chunk][(y % 16) * 16 + x % 16] in (0, 1, 3, 5, 6):
+                        positions.append((x + 0.5, y + 0.5))
+            positions.sort(key=lambda xy: (math.dist(xy, center), xy))
+            if len(positions) < 96:
+                raise RuntimeError("too few walkable wooded tiles")
+            for index, (fighter, at) in enumerate(zip(fighters, positions)):
+                call("place_at", fighter, *at)
+                call("grant_items", fighter, "spear", 1)
+                call("set_behavior", fighter, json.dumps({"first": [
+                    {"if": {"cond": {"threatened": True}, "then": {"do": {"skill": "dodge" if index % 2 else "block"}}}},
+                    {"do": {"skill": "strike", "target": {"nearest": "person"}}},
+                ]}))
+                if index % 2 == 0:
+                    call("place_structure", fighter, "remains")
+            call("set_paused", False)
+            count = 8
+            spots = [(center[0] + 8 * math.cos(i * math.tau / count),
+                      center[1] + 8 * math.sin(i * math.tau / count)) for i in range(count)]
+        else:
+            if ambient != 64:
+                raise RuntimeError(f"expected 64 Cullet residents, got {ambient}")
+            count = 152
+            _, spots = load.clusters(sql("SELECT * FROM lot"), 7, 3.0, -(-count // 7))
+
+        tokens = [load.new_identity() for _ in range(count)]
+        client = load.Proc([binary, "players"], evidence / "players.stderr")
+        client.send(json.dumps({
+            "uri": load.URL, "db": db, "events": str(evidence / "events.jsonl"),
+            "battle": center, "behaviour": {"walk_period_ms": 1500},
+            "players": [{"token": token, "name": f"Feed{i}", "role": "walk"} for i, token in enumerate(tokens)],
+            "client": "game", "feed_probe": True,
+        }))
+        joined = client.expect("joined", 300)
+        for player, (x, y) in zip(joined["players"], spots):
+            call("place_at", player["id"], x, y)
+        client.send("placed")
+        client.expect("ready", 300)
+        day_ms = sql("SELECT day_ms FROM world")[0]["day_ms"]
+        noon = time.time_ns() // 1_000_000 - day_ms * 5 // 24
+        harness("sql", f"UPDATE world SET epoch_ms = {noon} WHERE id = 0")
+        client.send("go")
+        time.sleep(5)
+        harness("doctor")
+        host_before = check_host()
+        start_census = census()
+        ident = battle.database_identity(db)
+        if not ident:
+            raise RuntimeError("could not resolve the database identity")
+        m0 = battle.metrics(ident)
+        first_stats = sql("SELECT ticks, at_ms FROM stats")[0]
+        call("set_profile", True)
+        start = time.time()
+        fighter_counts = []
+        try:
+            for offset in range(5, args.seconds, 5):
+                time.sleep(max(0, start + offset - time.time()))
+                if fighters:
+                    bodies = sql("SELECT id, x, y FROM body")
+                    local = sum(row["id"] in fighters and math.dist((row["x"], row["y"]), center) <= 16
+                                for row in bodies)
+                    fighter_counts.append(local)
+            time.sleep(max(0, start + args.seconds - time.time()))
+        finally:
+            end = time.time()
+            call("set_profile", False)
+        last_stats = sql("SELECT ticks, at_ms FROM stats")[0]
+        m1 = battle.metrics(ident)
+        end_census = census()
+        log = stdb("logs", "-s", "local", db, "-n", "450000")
+        (evidence / "module.log").write_text(log)
+        spans = load.spans(log, start, end)
+        ticks = spans.get("tick", [])
+        if not ticks or last_stats["ticks"] <= first_stats["ticks"] or client.p.poll() is not None:
+            raise RuntimeError("missing tick samples or live SDK workload")
+        diags, diag_seconds = battle.diag_counts(type("Run", (), {"db": db})(), start, end)
+        elapsed = end - start
+        actions = sql(f"SELECT COUNT(*) AS n FROM skill_use WHERE accepted_ms >= {int(start * 1000)} AND accepted_ms < {int(end * 1000)}")[0]["n"]
+        sight = {key: sum(values) / elapsed for key, values in spans.items()
+                 if key.startswith(("sight.", "scene.sensed"))}
+        bytes_key = "spacetime_num_bytes_sent_to_clients_total"
+        memory_key = "spacetime_worker_wasm_memory_bytes"
+        if any(key not in data for data in (m0, m1) for key in (bytes_key, memory_key)):
+            raise RuntimeError("missing required DB metrics")
+        # Close the original connections before reconnecting with the retained player identity.
+        client.p.terminate()
+        client.p.wait(timeout=30)
+        reconnect = subprocess.run([binary, "feed-snapshot"], text=True, input=json.dumps({
+            "uri": load.URL, "db": db, "token": tokens[0],
+        }) + "\n", capture_output=True, check=True, timeout=60)
+        result = dict(workload=args.workload, arm=args.arm, duration_s=elapsed,
+                      host_before=host_before, host_after=host(), clients=count, ambient=ambient,
+                      census=[len(start_census), len(end_census)],
+                      fighters=[sum(f in c for f in fighters) for c in (start_census, end_census)],
+                      local_fighters_in_16m=fighter_counts, accepted_skill_uses_s=actions / elapsed,
+                      sight_ms_s=sum(sight.values()), sight_spans_ms_s=sight,
+                      tick_ms=statistics.mean(ticks), tick_samples=len(ticks),
+                      ticks_s=(last_stats["ticks"] - first_stats["ticks"]) * 1000 / (last_stats["at_ms"] - first_stats["at_ms"]),
+                      late_share=sum(tick > 16.7 for tick in ticks) / len(ticks),
+                      copy_writes_s=sum(value for key, value in diags.items() if key.startswith("feed_probe:")),
+                      diagnostic_seconds=diag_seconds,
+                      total_kb_s_per_client=(m1[bytes_key] - m0[bytes_key]) / (1000 * elapsed * count),
+                      reconnect=json.loads(reconnect.stdout), wasm_memory_bytes=[m0[memory_key], m1[memory_key]],
+                      metrics_before=m0, metrics_after=m1)
+        (evidence / "result.json").write_text(json.dumps(result, indent=2) + "\n")
+        if fighters and result["fighters"] != [96, 96]:
+            raise RuntimeError("fighter census fell below 96")
+        print(json.dumps({key: value for key, value in result.items() if not key.startswith("metrics_")}), flush=True)
+    finally:
+        if client and client.p.poll() is None:
+            client.p.terminate()
+            client.p.wait(timeout=30)
+        if attempted:
+            harness("cleanup")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--run", required=True)
+    parser.add_argument("--workload", choices=("round", "middle", "woods"), required=True)
+    parser.add_argument("--arm", choices=("off", "on"), required=True)
+    parser.add_argument("--woods-seed", type=lambda path: Path(path).resolve())
+    parser.add_argument("--seconds", type=int, default=30)
+    args = parser.parse_args()
+    if args.workload == "woods" and (
+        not args.woods_seed or args.woods_seed.suffix != ".json" or not args.woods_seed.is_file()
+    ):
+        parser.error("--woods-seed must point to the archived cover acceptance fixture JSON")
+    if os.environ.get("LIVING_STDB_CONTAINER") != "slop-feed-scoping-stdb" or load.URL != "http://127.0.0.1:3398":
+        parser.error("requires the dedicated slop-feed-scoping-stdb server at 127.0.0.1:3398")
+    if Path(os.environ["CARGO_TARGET_DIR"]).resolve() != Path.home() / "slop-feedscope-target":
+        parser.error("requires the dedicated cargo target")
+    with (Path.home() / "slop-mq/battle.lock").open("r") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        run(args)
+
+
+if __name__ == "__main__":
+    main()
