diff --git a/living/authority/src/feed_probe.rs b/living/authority/src/feed_probe.rs
new file mode 100644
index 00000000..60b643a6
--- /dev/null
+++ b/living/authority/src/feed_probe.rs
@@ -0,0 +1,189 @@
+//! Scratch cost probe. The legacy feeds remain public in both benchmark arms.
+use crate::{
+    common, perception,
+    tables::{world_law__view, Structure},
+};
+use living_rules::{map::Map, script::Senses};
+use spacetimedb::{Identity, ReducerContext, Table, ViewContext};
+
+pub fn enabled(ctx: &ReducerContext) -> bool {
+    common::laws(ctx).feed_scope_probe
+}
+
+pub fn mutable(kind: &str) -> bool {
+    !matches!(
+        kind,
+        "house" | "shelter" | "hall" | "workshop" | "market" | "inn"
+    )
+}
+
+pub fn visible(
+    map: &Map,
+    at: (f32, f32),
+    heading: f32,
+    senses: &Senses,
+    row: &Structure,
+    distance: f32,
+) -> bool {
+    living_rules::sight::sees(
+        map,
+        at,
+        heading,
+        (row.x, row.y),
+        distance,
+        senses,
+        0.0,
+        None,
+    )
+}
+
+/// For callers that already have local candidates and need a single observer snapshot.
+pub struct Look {
+    map: std::rc::Rc<Map>,
+    heading: f32,
+    senses: Senses,
+}
+
+impl Look {
+    pub fn new(ctx: &ReducerContext, actor: u32, world: &crate::tables::World, now: u64) -> Self {
+        use crate::tables::body;
+        Self {
+            map: common::map(ctx),
+            heading: ctx
+                .db
+                .body()
+                .id()
+                .find(actor)
+                .map_or(0.0, |b| common::facing_at(&b, now)),
+            senses: common::senses_of(ctx, actor, world, now),
+        }
+    }
+
+    pub fn sees(&self, at: (f32, f32), row: &Structure, distance: f32) -> bool {
+        !mutable(&row.kind) || visible(&self.map, at, self.heading, &self.senses, row, distance)
+    }
+}
+
+#[derive(Clone, PartialEq, spacetimedb::SpacetimeType)]
+pub struct FeedProbeObject {
+    pub id: u64,
+    pub kind: String,
+    pub x: f32,
+    pub y: f32,
+    pub gate_open: Option<bool>,
+    pub lit_until_ms: u64,
+}
+
+#[spacetimedb::table(accessor = feed_probe_copy)]
+pub struct FeedProbeCopy {
+    #[primary_key]
+    #[auto_inc]
+    pub id: u64,
+    #[index(btree)]
+    pub viewer: Identity,
+    pub character: u32,
+    pub object: FeedProbeObject,
+}
+
+#[spacetimedb::view(accessor = my_feed_probe, public, primary_key = id)]
+pub fn my_feed_probe(ctx: &ViewContext) -> Vec<FeedProbeObject> {
+    if !ctx
+        .db
+        .world_law()
+        .name()
+        .find("feed_scope_probe".to_string())
+        .is_some_and(|row| row.value == "true")
+    {
+        return Vec::new();
+    }
+    let Some(character) = perception::living(ctx) else {
+        return Vec::new();
+    };
+    ctx.db
+        .feed_probe_copy()
+        .viewer()
+        .filter(ctx.sender())
+        .filter(|row| row.character == character.id)
+        .map(|row| row.object)
+        .collect()
+}
+
+pub fn sweep(
+    ctx: &ReducerContext,
+    viewer: Identity,
+    character: u32,
+    at: (f32, f32),
+    heading: f32,
+    senses: &Senses,
+    map: &Map,
+) {
+    use crate::tables::gate;
+    let span = common::detail_span("sight.feed_probe_player");
+    let mut visible_objects = Vec::new();
+    common::for_structures_near(ctx, at, senses.sight, |row, distance| {
+        if mutable(&row.kind) && visible(map, at, heading, senses, row, distance) {
+            visible_objects.push(row.clone());
+        }
+    });
+    drop(span);
+
+    let mut old: std::collections::HashMap<_, _> = ctx
+        .db
+        .feed_probe_copy()
+        .viewer()
+        .filter(viewer)
+        .map(|row| (row.object.id, row))
+        .collect();
+    for row in visible_objects {
+        let gate_open = (row.kind == "gate")
+            .then(|| ctx.db.gate().id().find(row.id))
+            .flatten()
+            .map(|gate| gate.open);
+        let object = FeedProbeObject {
+            id: row.id,
+            kind: row.kind,
+            x: row.x,
+            y: row.y,
+            gate_open,
+            lit_until_ms: row.lit_until_ms,
+        };
+        match old.remove(&object.id) {
+            Some(prior) if prior.character == character && prior.object == object => {}
+            Some(prior) => {
+                ctx.db.feed_probe_copy().id().update(FeedProbeCopy {
+                    id: prior.id,
+                    viewer,
+                    character,
+                    object,
+                });
+                common::diag(|| "feed_probe:update", 1);
+            }
+            None => {
+                ctx.db.feed_probe_copy().insert(FeedProbeCopy {
+                    id: 0,
+                    viewer,
+                    character,
+                    object,
+                });
+                common::diag(|| "feed_probe:insert", 1);
+            }
+        }
+    }
+    for row in old.into_values() {
+        ctx.db.feed_probe_copy().id().delete(row.id);
+        common::diag(|| "feed_probe:delete", 1);
+    }
+}
+
+pub fn forget(ctx: &ReducerContext, viewer: Identity) {
+    let ids: Vec<_> = ctx
+        .db
+        .feed_probe_copy()
+        .viewer()
+        .filter(viewer)
+        .map(|row| row.id)
+        .collect();
+    for id in ids {
+        ctx.db.feed_probe_copy().id().delete(id);
+    }
+}
