# Shared character bake-off shot list (dev-box, 2026-11-26)
# Sourced by ~/.local/state/bakeoff/shoot.sh and usable directly with living/tools/view_assets.sh.
#
# Framing (living/game/src/view.rs):
#   idle@1.0/0:8:0.62:0.50     full body front (yaw 0, pitch 8, zoom 0.62, aim 0.50; ~85-90% frame height)
#   idle@1.0/40:18:0.62:0.50   full body three-quarter (yaw 40, pitch 18, zoom 0.62, aim 0.50; ~85-90% frame height)
#   idle@1.0/180:8:0.62:0.50   full body back (yaw 180, pitch 8, zoom 0.62, aim 0.50; ~85-90% frame height)
#   idle@1.0/0:8:0.22:0.88     face close-up (yaw 0, pitch 8, zoom 0.22, aim 0.88)
#   idle@1.0/0:6:0.26:0.48     hands close-up at sides (yaw 0, pitch 6, zoom 0.26, aim 0.48)
#   idle@1.0/near@0            Near play camera stop (8 m up, 58 deg down at chest, FOV 42 deg)
#   idle@1.0/middle@0          Middle play camera stop (12 m up, 58 deg down at chest, FOV 44 deg)
#   idle@1.0/game              default top-down play camera (28 deg down, 22 m)
#   walk/three-quarter         6-frame walk clip from three-quarter view
#
# Bind pose requires a second view_assets.sh pass with LIVING_GAME_VIEW_CLIP=bind:
#   LIVING_GAME_VIEW_SHOTS_BIND="0:8:0.62:0.50,40:18:0.62:0.50,180:8:0.62:0.50"
#
export LIVING_GAME_SIZE="1600x900"
export LIVING_GAME_HOUR="11"
export LIVING_GAME_DAY_MINUTES="0"
export LIVING_GAME_VIEW_SHOTS="idle@1.0/0:8:0.62:0.50,idle@1.0/40:18:0.62:0.50,idle@1.0/180:8:0.62:0.50,idle@1.0/0:8:0.22:0.88,idle@1.0/0:6:0.26:0.48,idle@1.0/near@0,idle@1.0/middle@0,idle@1.0/game,walk/three-quarter"
export LIVING_GAME_VIEW_SHOTS_BIND="0:8:0.62:0.50,40:18:0.62:0.50,180:8:0.62:0.50"
