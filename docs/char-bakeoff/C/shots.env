# Shared character bake-off shot list (dev-box, 2026-11-26)
# Sourced by ~/.local/state/bakeoff/shoot.sh and usable directly with living/tools/view_assets.sh.
#
# Framing (living/game/src/view.rs):
#   idle@1.0/front             full body front (yaw 0, pitch 8) in idle pose
#   idle@1.0/three-quarter     full body three-quarter (yaw 40, pitch 18) in idle pose
#   idle@1.0/back              full body back (yaw 180, pitch 8) in idle pose
#   idle@1.0/0:8:0.22:0.88     face close-up (yaw 0, pitch 8, zoom 0.22, aim 0.88)
#   idle@1.0/near@0            Near play camera stop (8 m up, 58 deg down at chest, FOV 42 deg)
#   idle@1.0/middle@0          Middle play camera stop (12 m up, 58 deg down at chest, FOV 44 deg)
#   idle@1.0/game              default top-down play camera (28 deg down, 22 m)
#   walk/three-quarter         6-frame walk clip from three-quarter view
#
# Bind pose requires a second view_assets.sh pass with LIVING_GAME_VIEW_CLIP=bind:
#   LIVING_GAME_VIEW_SHOTS_BIND="front,three-quarter,back"
#
export LIVING_GAME_SIZE="1600x900"
export LIVING_GAME_HOUR="11"
export LIVING_GAME_DAY_MINUTES="0"
export LIVING_GAME_VIEW_SHOTS="idle@1.0/front,idle@1.0/three-quarter,idle@1.0/back,idle@1.0/0:8:0.22:0.88,idle@1.0/near@0,idle@1.0/middle@0,idle@1.0/game,walk/three-quarter"
export LIVING_GAME_VIEW_SHOTS_BIND="front,three-quarter,back"
