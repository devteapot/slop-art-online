{
 "_doc": "Starting heed policies (heed instincts) per species: seed content, docs/ATTENTION_BUDGET.md §2.4. A character without its own policy keeps track of others by its species' entry (heed_<kind>), else heed_default. A mind may rewrite all of it. Whom one is acting on, and whoever made contact with one within the world's heed_contact_s, are individuals whatever the policy (the engine's, not a rule here). hold_s is hysteresis as policy content: what a rule took stays for that long unless a better rule needs the place. Grammar: living/rules/src/heed.rs. heed_person is the instinct since E4's reweight (docs/ATTENTION_E4.md §5): whoever one is at enmity with (a hostile stance or relation) and whoever is visibly hostile toward someone one heeds rank above family and plain nearness. heed_person_v1 is the instinct before it, kept for comparison: the world law heed_instinct 1 selects the _v1 entries. The instincts write hurt_me (a blow of its hurt me), what the grammar's attacker meant before E5 §8 widened attacker to whoever went for one.",
 "heed_person": {
  "heed": [
   {
    "if": {
     "any": [
      {
       "threatened": true
      },
      {
       "doing": {
        "is": "hostile",
        "at_me": true
       }
      },
      {
       "hurt_me": {
        "within_s": 10
       }
      }
     ]
    },
    "order": "nearest",
    "hold_s": 5,
    "why": "whoever is going for me"
   },
   {
    "if": {
     "addressing": {
      "within_s": 10
     }
    },
    "order": "newest",
    "take": 2,
    "hold_s": 5,
    "why": "whoever speaks to me"
   },
   {
    "if": {
     "any": [
      {
       "cued": true
      },
      {
       "chosen": true
      }
     ]
    },
    "order": "nearest",
    "take": 4,
    "hold_s": 5,
    "why": "whoever I watch for"
   },
   {
    "if": {
     "who": {
      "kind": "person",
      "relation": "enemy"
     }
    },
    "order": "nearest",
    "hold_s": 5,
    "why": "whoever stands against me"
   },
   {
    "if": {
     "all": [
      {
       "acting_on_heeded": true
      },
      {
       "doing": {
        "is": "hostile"
       }
      }
     ]
    },
    "order": "nearest",
    "hold_s": 3,
    "why": "whoever is going for someone I watch"
   },
   {
    "if": {
     "all": [
      {
       "who": {
        "kind": "person",
        "relation": "family"
       }
      },
      {
       "near": 20
      }
     ]
    },
    "order": "nearest",
    "take": 2,
    "hold_s": 5,
    "why": "my own people"
   },
   {
    "if": {
     "near": 8
    },
    "order": "nearest",
    "take": 6,
    "hold_s": 3,
    "why": "who is close"
   },
   {
    "score": [
     {
      "if": {
       "closing": {
        "above": 1.0
       }
      },
      "w": 3
     },
     {
      "if": {
       "acting_on_heeded": true
      },
      "w": 3
     },
     {
      "if": {
       "fighting": true
      },
      "w": 2
     },
     {
      "if": {
       "who": "wolf"
      },
      "w": 2
     },
     {
      "if": {
       "new": 5
      },
      "w": 1
     },
     {
      "if": {
       "loud": true
      },
      "w": 1
     }
    ],
    "take": "rest",
    "hold_s": 3,
    "why": "whatever stands out"
   }
  ]
 },
