#!/bin/sh
# SpacetimeDB CLI inside the living core's server container (see living/deploy/compose.yml).
# Exec into the container directly: compose would need the git-ignored env file, which a git worktree lacks.
# LIVING_STDB_CONTAINER names a worker's own server instead of the shared one.
exec docker exec -i "${LIVING_STDB_CONTAINER:-sao-living_spacetimedb_1}" spacetime "$@"
