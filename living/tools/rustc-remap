#!/bin/sh
# The rustc of every cargo build in this repository (.cargo/config.toml, `build.rustc`;
# docs/TOOLING.md, "Byte-identical wasm"). Native compiles run rustc unchanged. A compile for
# wasm32-unknown-unknown also gets --remap-path-prefix flags, so a module embeds no host path:
#
#   CARGO_HOME           -> /cargo  registry and git crates' panic locations
#                                   (/home/<user>/.cargo/registry/src/...: the authority wasm
#                                   differed between dev-box and the Spark, and genesis init
#                                   fuel by ~0.02%)
#   this checkout        -> /src    workspace crates are passed relative already; a safety net,
#                                   added only when rustc runs inside the checkout (workspace
#                                   crates), so registry crates' flags name no checkout
#   the crate's OUT_DIR  -> /out    generated sources a crate includes from the target dir;
#                                   added only when its build script wrote files there
#
# The standard library is already /rustc/<commit>. Both the given and the resolved (symlink-free)
# spelling of each prefix are mapped. The last matching flag wins, so OUT_DIR (often inside the
# checkout) comes last. The two conditions keep a path that cannot be in the output out of the
# flags: under sccache the flags are in its cache key, and registry crates then still hit across
# checkouts and target directories.
#
# One computation, two callers:
#   rustc-remap ARGS...                 cargo's rustc (build.rustc): exec rustc ARGS FLAGS
#   rustc-remap --remap-flags ARGS...   print FLAGS, one per line (none for a native compile);
#                                       living/tools/sccache-rustc appends them itself, because
#                                       sccache runs the real rustc it finds through rustup and
#                                       never this script (docs/TOOLING.md)
# Cargo cannot see the flags: .cargo/config.toml also gives the wasm target a no-op marker remap,
# so changing this mapping means bumping that marker, which rebuilds wasm crates and changes
# sccache's key.
#
# `RUSTC` in the environment replaces this script (cargo prefers it over build.rustc): no remap,
# and the gate's host-path check (living/tools/host_paths.py) fails the module.
print=
[ "${1:-}" = --remap-flags ] && { print=1; shift; }
wasm=
prev=
for a in "$@"; do
  case "$a" in
    --target=wasm32-unknown-unknown) wasm=1 ;;
    wasm32-unknown-unknown) [ "$prev" = --target ] && wasm=1 ;;
  esac
  prev=$a
done
if [ -z "$wasm" ]; then
  [ -n "$print" ] && exit 0
  exec rustc "$@"
fi

remap() {  # remap FROM TO: FROM as given and as resolved
  [ -n "$1" ] || return 0
  set -- "$@" "$(cd "$1" 2>/dev/null && pwd -P)"
  map="$map --remap-path-prefix=$1=$2"
  [ -z "$3" ] || [ "$3" = "$1" ] || map="$map --remap-path-prefix=$3=$2"
}
inside() {  # inside DIR: the working directory is DIR or under it (as given or resolved)
  [ -n "$1" ] || return 1
  case "$PWD/" in "$1"/*) return 0 ;; esac
  r=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  case "$(pwd -P)/" in "$r"/*) return 0 ;; esac
  return 1
}
map=
root=$(cd "$(dirname "$0")/../.." && pwd)
inside "$root" && remap "$root" /src
remap "${CARGO_HOME:-$HOME/.cargo}" /cargo
[ -n "${OUT_DIR:-}" ] && [ -n "$(ls -A "$OUT_DIR" 2>/dev/null)" ] && remap "$OUT_DIR" /out
if [ -n "$print" ]; then
  # shellcheck disable=SC2086
  [ -z "$map" ] || printf '%s\n' $map
  exit 0
fi
# Word splitting of $map: none of these paths may contain whitespace (cargo's own paths do not).
# shellcheck disable=SC2086
exec rustc "$@" $map
