#!/bin/sh
# RUSTC_WRAPPER that runs rustc through sccache (living/tools/check.py sets it; docs/TOOLING.md).
#
# sccache puts every CARGO_* variable in a Rust compile's cache key. Cargo hands rustc the
# caller's environment, so a worktree's private CARGO_TARGET_DIR (or terminal settings) would
# make each worktree's cache entries its own. rustc reads none of these, so they are removed
# here; registry crates then hit across worktrees on one machine. (The cwd and
# CARGO_MANIFEST_DIR stay in the key, so workspace crates still hit only in their own
# worktree, and cargo does not cache incremental builds of them anyway.)
unset CARGO_TARGET_DIR CARGO_BUILD_TARGET_DIR CARGO_BUILD_BUILD_DIR CARGO_BUILD_JOBS \
  CARGO_TERM_COLOR CARGO_TERM_PROGRESS_WHEN CARGO_TERM_PROGRESS_WIDTH CARGO_TERM_VERBOSE \
  CARGO_TERM_QUIET CARGO_TERM_HYPERLINKS CARGO_TERM_UNICODE CARGO_LOG CARGO_HTTP_TIMEOUT \
  CARGO_NET_RETRY CARGO_NET_OFFLINE
# check.py sets SLOP_SCCACHE to the pinned copy (living/tools/install_sccache.sh); without it,
# the pinned copy if installed, else an sccache on PATH.
if [ -z "${SLOP_SCCACHE:-}" ]; then
  SLOP_SCCACHE="$HOME/.local/share/slop-tools/bin/sccache"
  [ -x "$SLOP_SCCACHE" ] || SLOP_SCCACHE=sccache
fi
# Cargo runs `sccache-rustc <its rustc> ARGS`; its rustc is living/tools/rustc-remap
# (.cargo/config.toml, build.rustc). sccache never runs that script: it finds a rustup proxy
# behind it (`rustc-remap +stable` succeeds) and compiles with the toolchain's own rustc, from
# `rustup which rustc` (sccache v0.19.0, src/compiler/compiler.rs, resolve_rust_compiler), so the
# script's path remapping was lost and wasm modules kept host paths. So the script is replaced
# here by plain `rustc`, as the script itself runs it, with its flags in the argv: sccache then
# passes them to rustc and puts them in its key (docs/TOOLING.md, "Byte-identical wasm"). A
# rustc-remap that predates --remap-flags (an older checkout) is passed through as before.
case "${1:-}" in
  */rustc-remap)
    if grep -q -e '--remap-flags' "$1" 2>/dev/null; then
      remap=$1
      shift
      flags=$("$remap" --remap-flags "$@") || exit 1
      # Word splitting of $flags: rustc-remap's paths hold no whitespace.
      # shellcheck disable=SC2086
      set -- rustc "$@" $flags
    fi ;;
esac
exec "$SLOP_SCCACHE" "$@"
