.DS_Store

# Local NPC endpoint credentials; never part of run evidence
/.local/credentials/

# Temporary test journals when the system temporary directory reaches its quota
/.local/test-tmp/
/.local/tmp/
# Short browser socket paths (Unix-domain sockets have a platform length limit)
/.local/t/

# Python tool caches
__pycache__/
*.py[cod]

# Local API keys
/.env

# Living core build output and local service data
/living/target/
/.local/living/
/living/viewer/dist/
/living/game/assets/lookdev/
/living/game/assets/view/
/living/game/assets/envs/*/
